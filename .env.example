# Google Gemini API
GEMINI_API_KEY="AQUÍ_TU_API_KEY_DE_GEMINI"

# Configuración de Asesores (separados por coma, formato internacional sin el +)
# Ejemplo: 5215551234567,5215551234568,5215551234569
ADVISOR_PHONES="AQUI_NUMEROS_DE_ASESORES_SEPARADOS_POR_COMA"

# Firebase Admin SDK (Ruta al archivo JSON de credenciales en local)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-adminsdk.json"

# PARA VERCEL (O NUBE): Pega todo el contenido del firebase-adminsdk.json en una sola linea aquí (Si usas esto, ignora el PATH)
