# Servidor
PORT=3000

# WhatsApp Cloud API
WHATSAPP_TOKEN="AQUÍ_TU_TOKEN_DE_WHATSAPP"
WHATSAPP_PHONE_ID="AQUÍ_ID_DE_TELEFONO"
